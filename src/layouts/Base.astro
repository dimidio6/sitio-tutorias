---
import { Image } from "astro:assets";
import { sitio } from "../lib/contenido";
import "../styles/site.css";

interface Props {
	title: string;
	description?: string;
	/** Ruta de la imagen para compartir en redes (por defecto, /og-default.jpg) */
	image?: string;
}

const { title, description = sitio.bajada, image = "/og-default.jpg" } =
	Astro.props;

const siteTitle = sitio.titulo;
const siteTagline = sitio.bajada;
const siteLogo = sitio.logo;
// "Facultad de Ingeniería · UNPSJB": el separador nunca queda solo al cortar la línea.
const taglineSinCortes = siteTagline.replace(/ · /g, "\u00a0·\u00a0");
const fullTitle = title === siteTitle ? `${siteTitle} | ${siteTagline}` : `${title} — ${siteTitle}`;

// Las URLs absolutas solo se pueden armar si `site` está definido en astro.config.mjs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#004a99" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script is:inline>
			// Antes de pintar: tema elegido por la persona o, si no eligió, el del sistema.
			(() => {
				let tema = null;
				try {
					tema = localStorage.getItem("tema");
				} catch {}
				if (tema !== "claro" && tema !== "oscuro") {
					tema = matchMedia("(prefers-color-scheme: dark)").matches
						? "oscuro"
						: "claro";
				}
				document.documentElement.dataset.tema = tema;
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="site-header">
			<nav class="navbar" aria-label="Navegación principal">
				<a class="nav-brand" href="/" aria-label={`${siteTitle} — Inicio`}>
					{
						siteLogo ? (
							<Image
								src={siteLogo.src}
								class="brand-logo"
								alt={siteLogo.alt || `${siteTitle} — UNPSJB`}
								width={96}
								densities={[1, 2]}
								priority
							/>
						) : null
					}
					<span class="brand-text">
						<span class="line-1">{siteTitle}</span>
						<span class="line-2">{taglineSinCortes}</span>
					</span>
				</a>

				<div class="nav-right">
					<ul class="nav-links" id="nav-list">
						{
							sitio.menu.map((item) => (
								<li>
									<a
										href={item.url}
										class={"destacado" in item ? "nav-btn" : undefined}
									>
										{item.texto}
									</a>
								</li>
							))
						}
					</ul>

					<button
						class="tema-switch"
						id="tema-switch"
						type="button"
						role="switch"
						aria-checked="false"
						aria-label="Tema oscuro"
						title="Cambiar entre tema claro y oscuro"
					>
						<span class="perilla" aria-hidden="true">
							<svg class="icono-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
								<circle cx="12" cy="12" r="4" />
								<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
							</svg>
							<svg class="icono-luna" viewBox="0 0 24 24" fill="currentColor">
								<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a.6.6 0 0 0-.8-.7A9.7 9.7 0 1 0 21.2 15a.6.6 0 0 0-.7-.8Z" />
							</svg>
						</span>
					</button>

					<button
						class="menu-toggle"
						id="mobile-menu"
						type="button"
						aria-label="Abrir menú de navegación"
						aria-expanded="false"
						aria-controls="nav-list"
					>
						<span class="bar"></span>
						<span class="bar"></span>
						<span class="bar"></span>
					</button>
				</div>
			</nav>
		</header>

		<main id="contenido">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					{
						siteLogo ? (
							<Image
								src={siteLogo.src}
								class="footer-logo"
								alt=""
								width={96}
								densities={[1, 2]}
								loading="lazy"
							/>
						) : null
					}
					<div>
						<p class="footer-title">{siteTitle}</p>
						<p class="footer-text">{taglineSinCortes}</p>
					</div>
				</div>

				<ul class="footer-contacto" aria-label="Contacto del Sistema de Tutorías">
					{sitio.contacto.ubicacion && (
						<li>
							{sitio.contacto.ubicacion}
							{sitio.contacto.ciudad && <span>{sitio.contacto.ciudad}</span>}
						</li>
					)}
					{sitio.contacto.email && (
						<li>
							<a href={`mailto:${sitio.contacto.email}`}>{sitio.contacto.email}</a>
						</li>
					)}
				</ul>
			</div>

			<div class="footer-bottom">
				<p>© {new Date().getFullYear()} {sitio.pie}</p>
				<p>
					Tutorías gratuitas para estudiantes de la Facultad de Ingeniería
					{sitio.credito && (
						<span class="footer-credito">
							{" · "}
							<a href={sitio.credito.url} target="_blank" rel="noopener">
								{sitio.credito.texto}
							</a>
						</span>
					)}
				</p>
			</div>
		</footer>

		<script>
			const temaSwitch =
				document.querySelector<HTMLButtonElement>("#tema-switch");
			const raiz = document.documentElement;

			const reflejarTema = () => {
				const oscuro = raiz.dataset.tema === "oscuro";
				temaSwitch?.setAttribute("aria-checked", String(oscuro));
				document
					.querySelector('meta[name="theme-color"]')
					?.setAttribute("content", oscuro ? "#0d1520" : "#004a99");
			};

			temaSwitch?.addEventListener("click", () => {
				raiz.dataset.tema = raiz.dataset.tema === "oscuro" ? "claro" : "oscuro";
				try {
					localStorage.setItem("tema", raiz.dataset.tema);
				} catch {
					// Sin almacenamiento disponible el cambio vale solo para esta visita.
				}
				reflejarTema();
			});
			reflejarTema();

			const menuToggle =
				document.querySelector<HTMLButtonElement>("#mobile-menu");
			const navList = document.querySelector<HTMLElement>("#nav-list");

			const closeMenu = () => {
				navList?.classList.remove("active");
				menuToggle?.setAttribute("aria-expanded", "false");
				menuToggle?.setAttribute("aria-label", "Abrir menú de navegación");
			};

			menuToggle?.addEventListener("click", () => {
				const isOpen = navList?.classList.toggle("active") ?? false;
				menuToggle.setAttribute("aria-expanded", String(isOpen));
				menuToggle.setAttribute(
					"aria-label",
					isOpen ? "Cerrar menú de navegación" : "Abrir menú de navegación",
				);
			});

			navList?.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", closeMenu);
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") closeMenu();
			});
		</script>
	</body>
</html>
