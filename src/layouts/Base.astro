---
import { Image } from "astro:assets";
import { sitio } from "../lib/contenido";
import "../styles/site.css";

interface Props {
	title: string;
	description?: string;
	/** Ruta de la imagen para compartir en redes (por defecto, /og-default.jpg) */
	image?: string;
}

const { title, description = sitio.bajada, image = "/og-default.jpg" } =
	Astro.props;

const siteTitle = sitio.titulo;
const siteTagline = sitio.bajada;
const siteLogo = sitio.logo;
const fullTitle = title === siteTitle ? `${siteTitle} | ${siteTagline}` : `${title} — ${siteTitle}`;

// Las URLs absolutas solo se pueden armar si `site` está definido en astro.config.mjs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#004a99" />
		<link rel="icon" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="site-header">
			<nav class="navbar" aria-label="Navegación principal">
				<a class="nav-brand" href="/" aria-label={`${siteTitle} — Inicio`}>
					{
						siteLogo ? (
							<Image
								src={siteLogo.src}
								class="brand-logo"
								alt={siteLogo.alt || `${siteTitle} — UNPSJB`}
								priority
							/>
						) : null
					}
					<span class="brand-text">
						<span class="line-1">{siteTitle}</span>
						<span class="line-2">{siteTagline}</span>
					</span>
				</a>

				<button
					class="menu-toggle"
					id="mobile-menu"
					type="button"
					aria-label="Abrir menú de navegación"
					aria-expanded="false"
					aria-controls="nav-list"
				>
					<span class="bar"></span>
					<span class="bar"></span>
					<span class="bar"></span>
				</button>

				<ul class="nav-links" id="nav-list">
					{
						sitio.menu.map((item) => (
							<li>
								<a
									href={item.url}
									class={"destacado" in item ? "nav-btn" : undefined}
								>
									{item.texto}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		<main id="contenido">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					{
						siteLogo ? (
							<Image src={siteLogo.src} class="footer-logo" alt="" loading="lazy" />
						) : null
					}
					<div>
						<p class="footer-title">{siteTitle}</p>
						<p class="footer-text">{siteTagline}</p>
					</div>
				</div>

				<nav class="footer-links" aria-label="Enlaces del pie de página">
					{
						sitio.menu.map((item) => (
							<a href={item.url}>{item.texto}</a>
						))
					}
				</nav>
			</div>

			<div class="footer-bottom">
				<p>© {new Date().getFullYear()} {sitio.pie}</p>
				<p>Tutorías gratuitas para estudiantes de la Facultad de Ingeniería.</p>
			</div>
		</footer>

		<script>
			const menuToggle =
				document.querySelector<HTMLButtonElement>("#mobile-menu");
			const navList = document.querySelector<HTMLElement>("#nav-list");

			const closeMenu = () => {
				navList?.classList.remove("active");
				menuToggle?.setAttribute("aria-expanded", "false");
				menuToggle?.setAttribute("aria-label", "Abrir menú de navegación");
			};

			menuToggle?.addEventListener("click", () => {
				const isOpen = navList?.classList.toggle("active") ?? false;
				menuToggle.setAttribute("aria-expanded", String(isOpen));
				menuToggle.setAttribute(
					"aria-label",
					isOpen ? "Cerrar menú de navegación" : "Abrir menú de navegación",
				);
			});

			navList?.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", closeMenu);
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") closeMenu();
			});
		</script>
	</body>
</html>
