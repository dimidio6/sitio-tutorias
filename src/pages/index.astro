---
import { getImage, Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import {
	carreras,
	coordinadores,
	correosPorCarrera,
	faqs,
	sitio,
	tutores,
} from "../lib/contenido";

const { hero, contacto, horarios } = sitio;
const slides = hero.imagenes;

// Imagen para compartir en redes: versión liviana de la primera foto.
const imagenRedes = slides[0]
	? await getImage({ src: slides[0].src, width: 1200, format: "jpg" })
	: null;

// Reparte los tutores en filas parejas (como máximo 5 por fila) para que en
// pantallas anchas nunca quede uno solo en la última: 9 → 4 + 5, 11 → 3 + 4 + 4.
const MAX_POR_FILA = 5;
const cantFilas = Math.ceil(tutores.length / MAX_POR_FILA);
const base = Math.floor(tutores.length / (cantFilas || 1));
const filasConExtra = tutores.length % (cantFilas || 1);
const filasTutores: (typeof tutores)[] = [];
for (let fila = 0, desde = 0; fila < cantFilas; fila++) {
	const largo = base + (fila >= cantFilas - filasConExtra ? 1 : 0);
	filasTutores.push(tutores.slice(desde, desde + largo));
	desde += largo;
}
const porFila = Math.max(0, ...filasTutores.map((fila) => fila.length));

const OTRA_CARRERA = "Otra carrera / Todavía no sé";
---

<Base
	title={sitio.titulo}
	description={hero.subtitulo}
	image={imagenRedes?.src}
>
	<section id="inicio" class="hero-shell">
		<div class="hero">
			<div class="hero-intro">
				<h1>{hero.titulo}</h1>
				<div class="hero-lateral">
					<p class="hero-subtitle">{hero.subtitulo}</p>
					<div class="hero-actions">
						<a class="btn" href={hero.boton.url}>
							<span>{hero.boton.texto}</span>
							<svg class="btn-arrow" viewBox="0 0 20 20" aria-hidden="true">
								<path d="M4 10h11m-4-4 4 4-4 4" />
							</svg>
						</a>
					</div>
					{hero.notas.length > 0 && (
						<ul class="hero-notas">
							{hero.notas.map((nota, index) => (
								<li>
									{index === 0 ? (
										<svg viewBox="0 0 20 20" aria-hidden="true">
											<path d="m5 10.5 3.2 3L15 6.5" />
										</svg>
									) : (
										<svg viewBox="0 0 20 20" aria-hidden="true">
											<path d="M10 17.5s5.5-4.4 5.5-8.6a5.5 5.5 0 1 0-11 0c0 4.2 5.5 8.6 5.5 8.6Z" />
											<circle cx="10" cy="8.8" r="1.9" />
										</svg>
									)}
									{nota}
								</li>
							))}
						</ul>
					)}
				</div>
			</div>

			{slides.length > 0 && (
				<div class="hero-banda">
					<div class="slider-container">
						<div
							class="hero-slider"
							aria-roledescription="carrusel"
							aria-label="Fotos de la Facultad de Ingeniería"
						>
							{slides.map((slide, index) => (
								<div
									class:list={["slide", { active: index === 0 }]}
									role="group"
									aria-roledescription="diapositiva"
									aria-label={`${index + 1} de ${slides.length}`}
									aria-hidden={index === 0 ? "false" : "true"}
									data-leyenda={slide.alt ?? ""}
									style={`--foco: ${slide.foco}`}
								>
									<Image
										src={slide.src}
										alt={slide.alt || "Facultad de Ingeniería - UNPSJB"}
										widths={[640, 960, 1280, 1800, 2400]}
										sizes="(max-width: 1248px) calc(100vw - 40px), 1200px"
										priority={index === 0}
										loading={index === 0 ? "eager" : "lazy"}
									/>
								</div>
							))}
						</div>
					</div>

					<div class="hero-banda-pie">
						<p class="slider-leyenda" aria-hidden="true">{slides[0]?.alt}</p>
						{slides.length > 1 && (
							<div class="slider-controles">
								<button
									type="button"
									class="slider-pausa"
									aria-label="Pausar fotos"
									data-estado="reproduciendo"
								>
									<svg class="icono-pausa" viewBox="0 0 20 20" aria-hidden="true">
										<path d="M7 5v10M13 5v10" />
									</svg>
									<svg class="icono-play" viewBox="0 0 20 20" aria-hidden="true">
										<path d="M7 5.5v9l7.5-4.5Z" />
									</svg>
								</button>
								<div class="slider-dots" aria-label="Elegir foto">
									{slides.map((_, index) => (
										<button
											type="button"
											data-slide={index}
											aria-label={`Ver foto ${index + 1} de ${slides.length}`}
											aria-current={index === 0 ? "true" : "false"}
										/>
									))}
								</div>
							</div>
						)}
					</div>
				</div>
			)}
		</div>
	</section>

	<section id="tutores" class="section about">
		<div class="container">
			<div class="section-heading">
				<h2>{sitio.tutores.titulo}</h2>
				{sitio.tutores.subtitulo && (
					<p class="subtitle">{sitio.tutores.subtitulo}</p>
				)}
			</div>

			{tutores.length > 0 ? (
				<div class="tutores-grid tutores-filas" style={`--por-fila: ${porFila}`}>
					{filasTutores.map((fila) => (
						<div class="tutores-fila">
							{fila.map((tutor) => (
								<article class="tutor-card tutor-card-accion">
									<div class="tutor-img-container">
										{tutor.foto ? (
											<Image
												src={tutor.foto.src}
												alt={tutor.foto.alt || `Foto de ${tutor.nombre}`}
												width={256}
												height={256}
												loading="lazy"
											/>
										) : (
											<span class="tutor-initials" aria-hidden="true">
												{tutor.iniciales}
											</span>
										)}
									</div>
									<h3>{tutor.nombre}</h3>
									<span class="carrera">{tutor.carrera}</span>
									<a
										class="tutor-consultar"
										href="#contacto"
										data-carrera={tutor.carrera}
									>
										Consultar
										<span class="sr-only"> sobre {tutor.carrera}</span>
									</a>
								</article>
							))}
						</div>
					))}
				</div>
			) : (
				<p class="tutor-empty">Todavía no hay tutores cargados.</p>
			)}
		</div>
	</section>

	{horarios.imagen && (
		<section id="horarios" class="section horarios">
			<div class="container horarios-layout">
				<div class="horarios-texto">
					<h2>{horarios.titulo}</h2>
					{horarios.subtitulo && <p class="subtitle">{horarios.subtitulo}</p>}
					<a
						class="link-flecha"
						href={horarios.imagen.src.src}
						target="_blank"
						rel="noopener"
					>
						Ver la grilla en tamaño completo
						<svg viewBox="0 0 20 20" aria-hidden="true">
							<path d="M7 13 13 7m-5 0h5v5" />
						</svg>
					</a>
				</div>
				<figure class="horarios-imagen">
					<a href={horarios.imagen.src.src} target="_blank" rel="noopener">
						<Image
							src={horarios.imagen.src}
							alt={horarios.imagen.alt ?? "Horarios de los tutores"}
							width={640}
							loading="lazy"
						/>
					</a>
				</figure>
			</div>
		</section>
	)}

	<section id="coordinadores" class="section coordinadores">
		<div class="container">
			<div class="section-heading">
				<h2>{sitio.coordinadores.titulo}</h2>
				{sitio.coordinadores.subtitulo && (
					<p class="subtitle">{sitio.coordinadores.subtitulo}</p>
				)}
			</div>

			{coordinadores.length > 0 ? (
				<div class="tutores-grid coordinadores-grid">
					{coordinadores.map((coordinator) => (
						<article class="tutor-card coordinador-card">
							<div class="tutor-img-container">
								{coordinator.foto ? (
									<Image
										src={coordinator.foto.src}
										alt={coordinator.foto.alt || `Foto de ${coordinator.nombre}`}
										width={256}
										height={256}
										loading="lazy"
									/>
								) : (
									<span class="tutor-initials" aria-hidden="true">
										{coordinator.iniciales}
									</span>
								)}
							</div>
							<h3>{coordinator.nombre}</h3>
						</article>
					))}
				</div>
			) : (
				<p class="tutor-empty">Todavía no hay coordinadores cargados.</p>
			)}
		</div>
	</section>

	<section id="preguntas" class="section faq">
		<div class="container">
			<div class="section-heading">
				<h2>{sitio.faq.titulo}</h2>
				{sitio.faq.subtitulo && <p class="subtitle">{sitio.faq.subtitulo}</p>}
			</div>

			{faqs.length > 0 ? (
				<div class="faq-container">
					{faqs.map((faq) => (
						<article class="faq-item">
							<span class="faq-icono" aria-hidden="true">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12Z" />
									<path d="M10.2 9.6a1.9 1.9 0 0 1 3.7.6c0 1.3-1.9 1.7-1.9 3" />
									<path d="M12 15.9h.01" />
								</svg>
							</span>
							<h3>{faq.pregunta}</h3>
							<p>{faq.respuesta}</p>
						</article>
					))}
				</div>
			) : (
				<p class="tutor-empty">Todavía no hay preguntas frecuentes cargadas.</p>
			)}
		</div>
	</section>

	<section id="contacto" class="section contact">
		<div class="container">
			<div class="section-heading">
				<h2>{contacto.titulo}</h2>
				{contacto.subtitulo && <p class="subtitle">{contacto.subtitulo}</p>}
			</div>

			<div class="contact-container">
				<div class="contact-form-card">
					<form
						id="contact-form"
						data-email={contacto.email}
						data-tutores={JSON.stringify(correosPorCarrera)}
						novalidate
					>
						<div class="form-grid">
							<div class="field">
								<label for="nombre">Nombre y apellido</label>
								<input
									id="nombre"
									name="nombre"
									type="text"
									autocomplete="name"
									required
								/>
							</div>

							<div class="field">
								<label for="email">Tu correo</label>
								<input
									id="email"
									name="email"
									type="email"
									autocomplete="email"
									inputmode="email"
									placeholder="nombre@gmail.com"
									aria-describedby="email-ayuda"
									required
								/>
								<p class="field-hint" id="email-ayuda">
									Puede ser el personal o el de la facultad.
								</p>
							</div>

							<div class="field field-full">
								<label for="carrera">Carrera</label>
								<select
									id="carrera"
									name="carrera"
									aria-describedby="carrera-ayuda"
									required
								>
									<option value="">Elegí tu carrera</option>
									{carreras.map((career) => (
										<option value={career}>{career}</option>
									))}
									<option value={OTRA_CARRERA}>{OTRA_CARRERA}</option>
								</select>
								<p class="field-hint" id="carrera-ayuda">
									Tu consulta le llega al equipo de tutorías y a los tutores de tu
									carrera.
								</p>
							</div>

							<div class="field field-full">
								<label for="mensaje">¿En qué te podemos dar una mano?</label>
								<textarea
									id="mensaje"
									name="mensaje"
									rows="5"
									placeholder="Contanos cómo te está yendo o qué te preocupa. No hace falta que sepas exactamente qué preguntar."
									required
								></textarea>
							</div>
						</div>

						<div class="form-actions">
							<button type="submit" class="btn">
								<span>{contacto.boton}</span>
								<svg class="btn-arrow" viewBox="0 0 20 20" aria-hidden="true">
									<path d="M4 10h11m-4-4 4 4-4 4" />
								</svg>
							</button>
							{contacto.nota && <p class="form-note">{contacto.nota}</p>}
						</div>

						<p class="form-estado" id="form-estado" role="status" aria-live="polite"></p>
					</form>

					<div class="envio-panel" id="envio-panel" tabindex="-1" hidden>
						<div class="envio-encabezado">
							<span class="envio-icono" aria-hidden="true">
								<svg viewBox="0 0 20 20">
									<path d="m5 10.5 3.2 3L15 6.5" />
								</svg>
							</span>
							<h3>Tu mensaje está listo</h3>
						</div>
						<p>
							Se abrió tu app de correo con todo cargado. Solo falta que lo
							envíes desde ahí.
						</p>
						<p class="envio-alt">¿No se abrió nada? Mandalo de otra forma:</p>
						<div class="envio-acciones">
							<a
								class="btn-sec"
								id="envio-gmail"
								href="https://mail.google.com/"
								target="_blank"
								rel="noopener"
							>
								Abrir en Gmail
							</a>
							<button type="button" class="btn-sec" id="envio-copiar">
								Copiar mensaje
							</button>
						</div>
						<p class="envio-dest">
							Si lo copiás, pegalo en un correo nuevo para{" "}
							<span id="envio-destinatarios"></span>.
						</p>
					</div>
				</div>

				<aside class="contact-info-card" aria-label="Datos de contacto">
					<h3>Datos de contacto</h3>
					<ul class="info-list">
						{contacto.ubicacion && (
							<li class="info-item">
								<span class="info-icon" aria-hidden="true">
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path d="M12 21s7-5.686 7-11a7 7 0 1 0-14 0c0 5.314 7 11 7 11Z" />
										<circle cx="12" cy="10" r="2.5" />
									</svg>
								</span>
								<div>
									<strong>Ubicación</strong>
									<span>{contacto.ubicacion}</span>
									{contacto.ciudad && (
										<span class="info-detalle">{contacto.ciudad}</span>
									)}
								</div>
							</li>
						)}

						{horarios.imagen && (
							<li class="info-item">
								<span class="info-icon" aria-hidden="true">
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<circle cx="12" cy="12" r="9" />
										<path d="M12 7v5l3 2" />
									</svg>
								</span>
								<div>
									<strong>Horarios</strong>
									<a href="#horarios">Ver los horarios de cada tutor</a>
								</div>
							</li>
						)}

						{contacto.email && (
							<li class="info-item">
								<span class="info-icon" aria-hidden="true">
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<rect x="3" y="5" width="18" height="14" rx="2" />
										<path d="m3 7 9 6 9-6" />
									</svg>
								</span>
								<div>
									<strong>Email</strong>
									<a href={`mailto:${contacto.email}`}>{contacto.email}</a>
								</div>
							</li>
						)}
					</ul>
				</aside>
			</div>
		</div>
	</section>

	<script>
		/* ---------- Carrusel del hero ---------- */

		const slider = document.querySelector<HTMLElement>(".hero-slider");

		if (slider) {
			const slides = Array.from(slider.querySelectorAll<HTMLElement>(".slide"));
			const dots = Array.from(
				document.querySelectorAll<HTMLButtonElement>(".slider-dots button"),
			);
			const pausa = document.querySelector<HTMLButtonElement>(".slider-pausa");
			const leyenda = document.querySelector<HTMLElement>(".slider-leyenda");
			const sinMovimiento = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			let current = 0;
			let timer: number | undefined;
			// Pausa elegida por la persona: gana sobre el hover y el foco.
			let pausadoAMano = sinMovimiento;

			const show = (index: number) => {
				if (slides.length === 0) return;
				current = (index + slides.length) % slides.length;
				slides.forEach((slide, slideIndex) => {
					const active = slideIndex === current;
					slide.classList.toggle("active", active);
					slide.setAttribute("aria-hidden", String(!active));
				});
				dots.forEach((dot, dotIndex) => {
					dot.setAttribute("aria-current", dotIndex === current ? "true" : "false");
				});
				if (leyenda) leyenda.textContent = slides[current].dataset.leyenda ?? "";
			};

			const stop = () => {
				if (timer !== undefined) window.clearInterval(timer);
				timer = undefined;
			};

			const start = () => {
				stop();
				if (slides.length > 1 && !pausadoAMano) {
					timer = window.setInterval(() => show(current + 1), 6000);
				}
			};

			const reflejarPausa = () => {
				if (!pausa) return;
				pausa.dataset.estado = pausadoAMano ? "pausado" : "reproduciendo";
				pausa.setAttribute(
					"aria-label",
					pausadoAMano ? "Reanudar fotos" : "Pausar fotos",
				);
			};

			pausa?.addEventListener("click", () => {
				pausadoAMano = !pausadoAMano;
				reflejarPausa();
				start();
			});

			dots.forEach((dot) => {
				dot.addEventListener("click", () => {
					show(Number(dot.dataset.slide));
					start();
				});
			});

			// Pausa al pasar el mouse por la foto o al usar sus controles.
			const contenedor = slider.closest<HTMLElement>(".hero-banda") ?? slider;
			contenedor.addEventListener("mouseenter", stop);
			contenedor.addEventListener("mouseleave", start);
			contenedor.addEventListener("focusin", stop);
			contenedor.addEventListener("focusout", start);
			reflejarPausa();
			start();
		}

		/* ---------- Formulario de contacto ---------- */

		const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
		const estado = document.querySelector<HTMLElement>("#form-estado");
		const panel = document.querySelector<HTMLElement>("#envio-panel");
		const selectCarrera = document.querySelector<HTMLSelectElement>("#carrera");

		type Campo = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

		// Mensajes propios: los del navegador salen en el idioma del navegador.
		const mensajeDeError = (campo: Campo) => {
			const valor = campo.value.trim();
			switch (campo.name) {
				case "nombre":
					return valor ? "" : "Escribí tu nombre y apellido.";
				case "email":
					if (!valor) return "Escribí tu correo para que podamos responderte.";
					return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(valor)
						? ""
						: "Ese correo no parece válido. Revisalo.";
				case "carrera":
					return valor ? "" : "Elegí tu carrera, o «Otra carrera / Todavía no sé».";
				case "mensaje":
					return valor ? "" : "Contanos en qué te podemos dar una mano.";
				default:
					return "";
			}
		};

		// Guarda la ayuda original de cada campo para combinarla con el error.
		const ayudaOriginal = new Map<Campo, string>();

		const validar = (campo: Campo) => {
			const mensaje = mensajeDeError(campo);
			const idError = `error-${campo.id}`;
			let aviso = document.getElementById(idError);

			if (!ayudaOriginal.has(campo)) {
				ayudaOriginal.set(campo, campo.getAttribute("aria-describedby") ?? "");
			}
			const ayuda = ayudaOriginal.get(campo) ?? "";

			if (!mensaje) {
				aviso?.remove();
				campo.removeAttribute("aria-invalid");
				if (ayuda) campo.setAttribute("aria-describedby", ayuda);
				else campo.removeAttribute("aria-describedby");
				return true;
			}

			if (!aviso) {
				aviso = document.createElement("p");
				aviso.id = idError;
				aviso.className = "field-error";
				campo.insertAdjacentElement("afterend", aviso);
			}
			aviso.textContent = mensaje;
			campo.setAttribute("aria-invalid", "true");
			campo.setAttribute("aria-describedby", [idError, ayuda].filter(Boolean).join(" "));
			return false;
		};

		const campos = contactForm
			? Array.from(contactForm.querySelectorAll<Campo>("input, select, textarea"))
			: [];

		// Una vez marcado un error, se corrige apenas la persona lo arregla.
		campos.forEach((campo) => {
			const revisar = () => {
				if (campo.hasAttribute("aria-invalid")) validar(campo);
				if (estado && !campos.some((c) => c.hasAttribute("aria-invalid"))) {
					estado.textContent = "";
				}
			};
			campo.addEventListener("input", revisar);
			campo.addEventListener("change", revisar);
		});

		// Botón "Consultar" de cada tutor: elige su carrera en el formulario.
		document.querySelectorAll<HTMLAnchorElement>(".tutor-consultar").forEach((boton) => {
			boton.addEventListener("click", () => {
				const carrera = boton.dataset.carrera;
				if (!selectCarrera || !carrera) return;
				selectCarrera.value = carrera;
				selectCarrera.dispatchEvent(new Event("change"));
				// Después del desplazamiento, el foco va al primer campo vacío.
				window.setTimeout(() => {
					const vacio = campos.find((c) => !c.value.trim()) ?? campos[0];
					vacio?.focus({ preventScroll: true });
				}, 450);
			});
		});

		let textoParaCopiar = "";

		document.querySelector("#envio-copiar")?.addEventListener("click", async (event) => {
			const boton = event.currentTarget as HTMLButtonElement;
			try {
				await navigator.clipboard.writeText(textoParaCopiar);
				boton.textContent = "¡Copiado!";
			} catch {
				boton.textContent = "No se pudo copiar";
			}
			window.setTimeout(() => (boton.textContent = "Copiar mensaje"), 2500);
		});

		contactForm?.addEventListener("submit", (event) => {
			event.preventDefault();

			const invalidos = campos.filter((campo) => !validar(campo));
			if (invalidos.length > 0) {
				if (estado) {
					estado.textContent =
						invalidos.length === 1
							? "Falta completar 1 campo. Lo marcamos en rojo."
							: `Faltan completar ${invalidos.length} campos. Los marcamos en rojo.`;
				}
				invalidos[0].focus();
				return;
			}
			if (estado) estado.textContent = "";

			const email = contactForm.dataset.email?.trim();
			if (!email) {
				window.alert("El correo de contacto todavía no está configurado.");
				return;
			}

			const data = new FormData(contactForm);
			const nombre = String(data.get("nombre") ?? "").trim();
			const correo = String(data.get("email") ?? "").trim();
			const carrera = String(data.get("carrera") ?? "");
			const mensaje = String(data.get("mensaje") ?? "").trim();

			// Destinatarios: el correo de tutorías más los tutores de esa carrera.
			const tutoresPorCarrera: Record<string, string[]> = JSON.parse(
				contactForm.dataset.tutores ?? "{}",
			);
			const destinatarios = [
				...new Set([email, ...(tutoresPorCarrera[carrera] ?? [])]),
			];

			const subject = `Consulta de tutoría — ${nombre}`;
			const body = [
				`Nombre: ${nombre}`,
				`Correo: ${correo}`,
				`Carrera: ${carrera}`,
				"",
				"Mensaje:",
				mensaje,
				// Para que el resto de los destinatarios vea que la consulta ya
				// se respondió: el aviso solo tiene sentido si hay varios.
				...(destinatarios.length > 1
					? [
							"",
							"—",
							"Equipo de tutorías: respondan con «Responder a todos» para que el resto sepa que esta consulta ya fue atendida.",
						]
					: []),
			].join("\n");

			// Alternativas por si no hay una app de correo configurada.
			textoParaCopiar = [
				`Para: ${destinatarios.join(", ")}`,
				`Asunto: ${subject}`,
				"",
				body,
			].join("\n");
			const gmail = document.querySelector<HTMLAnchorElement>("#envio-gmail");
			if (gmail) {
				gmail.href = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(
					destinatarios.join(","),
				)}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			}
			const listaDestinatarios = document.querySelector("#envio-destinatarios");
			if (listaDestinatarios) listaDestinatarios.textContent = destinatarios.join(", ");

			if (panel) {
				panel.hidden = false;
				panel.focus();
			}

			window.location.href = `mailto:${destinatarios.join(
				",",
			)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		});
	</script>
</Base>
