---
import Base from "../layouts/Base.astro";
---

<Base
	title="Página no encontrada"
	description="La página que buscás no existe o cambió de dirección."
>
	<section class="not-found">
		<span class="not-found-code">Error 404</span>
		<h1>No encontramos esa página</h1>
		<p>
			Puede que el enlace esté mal escrito o que el contenido se haya movido.
			Volvé al inicio para seguir navegando.
		</p>
		<a class="btn" href="/">Volver al inicio</a>
	</section>
</Base>
